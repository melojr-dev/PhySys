# Copie para .env antes de iniciar a aplica��o.
PHYSIOAI_ADMIN_USER=admin
PHYSIOAI_ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica
PHYSIOAI_AUTH_SECRET=troque-por-ao-menos-32-caracteres-aleatorios
PHYSIOAI_PSEUDONYM_SECRET=use-outro-segredo-longo-e-estavel-para-pseudonimos
PHYSIOAI_TOKEN_TTL_SECONDS=28800
PHYSIOAI_RESULT_TTL_SECONDS=900
PHYSIOAI_PREFLIGHT_TTL_SECONDS=900
PHYSIOAI_PREFLIGHT_MAX_SAMPLES=12
PHYSIOAI_REQUIRE_PREFLIGHT=1
# Normalmente vazio quando frontend/backend s�o same-origin pelo Nginx.
PHYSIOAI_ALLOWED_ORIGINS=

# 127.0.0.1 = somente esta m�quina. Para acesso na LAN/mobile, use 0.0.0.0 em rede confi�vel.
PHYSIOAI_BIND_ADDRESS=127.0.0.1
PHYSIOAI_HTTP_PORT=80

# Capacidade e observabilidade (Fase 7)
PHYSIOAI_MAX_INFLIGHT_JOBS=3
PHYSIOAI_MAX_UPLOAD_MB=256
PHYSIOAI_MAX_TOTAL_UPLOAD_MB=512
# Limita backlog de telemetria por job quando navegador/rede ficam lentos.
PHYSIOAI_WS_QUEUE_MAX=512
PHYSIOAI_ENABLE_EXPERIMENTAL_INPUTS=0
PHYSIOAI_MIN_FREE_DISK_MB=512
# PRAGMA quick_check � cacheado para n�o varrer o SQLite a cada healthcheck.
PHYSIOAI_DB_QUICKCHECK_INTERVAL_SECONDS=300
PHYSIOAI_LOG_FORMAT=json
PHYSIOAI_LOG_LEVEL=INFO

# Build metadata (normalmente preenchido pelo script de release)
PHYSIOAI_VERSION=2.22.0-rc.5
PHYSIOAI_GIT_SHA=unknown
PHYSIOAI_BUILD_TIME=unknown

# Runtime cl�nico. No Docker Compose, /app/data � configurado automaticamente.
# Em execu��o local, deixe vazio para usar backend/src/utils.
# PHYSIOAI_DATA_DIR=/caminho/persistente
# PHYSIOAI_DB_PATH=/caminho/persistente/physioai_clinical.sqlite3
